# preparar.py crea .env con llaves aleatorias en el primer arranque. No lo compartas.
# ¡RESPALDA .env! Sin SECRET_KEY no se pueden descifrar los CSD guardados.
SECRET_KEY=
JWT_SECRET=
ADMIN_EMAIL=rick@erickddp.com
ADMIN_PASSWORD=cambiame
# Consola de depuración con traza completa de errores (True/False)
DEBUG=True
DATA_DIR=./datos
DATABASE_URL=sqlite:///./datos/timbra.db
# Para mandar facturas por correo (Gmail: usa "contraseña de aplicación")
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
